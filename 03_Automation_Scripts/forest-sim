#!/bin/bash
# NOTE (FOREST-OS-REPO-ALIGNMENT-001): container ports are published without an explicit
# loopback host address; reachability depends on runtime/firewall config. Pinning
# 127.0.0.1 is a separate runtime-hardening change (follow-up R1).
# Forest OS: forest-sim Host CLI Integration Wrapper
# Governance: Doc-414 Compliant (Zero em dashes, strict claims discipline)

set -e

IMAGE_NAME="${FOREST_SIM_IMAGE:-forest-sim}"

# Detect container runtime (Podman or Docker)
detect_runtime() {
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        echo ""
    fi
}

RUNTIME=$(detect_runtime)
if [ -z "${RUNTIME}" ]; then
    echo "Error: Neither podman nor docker found in PATH." >&2
    echo "Please install a container runtime to execute Tier 3 scientific sidecars." >&2
    exit 1
fi

print_help() {
    cat <<EOF
Forest OS Growth & Yield Simulation CLI (forest-sim)
Target Container: ${IMAGE_NAME}
Engines: USDA Open-FVS & Vibrant Planet microfvs

Usage:
  forest-sim fvs <variant> <keyfile>  Execute an FVS regional variant simulation
  forest-sim variants                 List compiled FVS variants in container
  forest-sim serve                    Launch microfvs REST API on http://localhost:8000
  forest-sim python <script.py>       Execute a Python simulation script
  forest-sim bash                     Open an interactive container shell
  forest-sim -h, --help               Display this help reference

Host Integration:
  - Current directory (\$PWD) is mounted to /workspace
  - Simulation output files written with host user UID:GID ($(id -u):$(id -g))
EOF
}

# Check for help flag
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_help
    exit 0
fi

# Verify that the container image exists
check_image() {
    if ! "${RUNTIME}" image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
        echo "Error: Container image '${IMAGE_NAME}' is not built." >&2
        echo "To build the image, run:" >&2
        echo "  bash 03_Automation_Scripts/build_containers.sh sim" >&2
        exit 1
    fi
}

check_image

# Service mode: microfvs REST API
if [ "$1" = "serve" ] || [ "$1" = "--web" ]; then
    PORT="${MICROFVS_PORT:-8000}"
    echo "Starting Forest OS microfvs REST API..."
    echo "Access URL:     http://localhost:${PORT}"
    echo "API Docs:       http://localhost:${PORT}/docs"
    echo "Press Ctrl+C to terminate service."
    exec "${RUNTIME}" run --rm -it \
        -p "${PORT}:8000" \
        -v "$PWD:/workspace" \
        -w /workspace \
        "${IMAGE_NAME}" serve
fi

# Variants list mode
if [ "$1" = "variants" ] || [ "$1" = "--variants" ]; then
    exec "${RUNTIME}" run --rm \
        "${IMAGE_NAME}" variants
fi

# Default execution forwarding with host volume mount
exec "${RUNTIME}" run --rm -it \
    -u "$(id -u):$(id -g)" \
    -v "$PWD:/workspace" \
    -w /workspace \
    "${IMAGE_NAME}" "$@"
